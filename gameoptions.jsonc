{
  // option ids should be between 100 and 199
  // See https://en.doc.boardgamearena.com/Options_and_preferences:_gameoptions.json,_gamepreferences.json for more details
  /*
  EXAMPLE:

  "101": {
    "name": "Draft variant",
    "values": {
      "0": {
        "name": "No draft"
      },
      "1": {
        "name": "Draft",
        "description": "Add a draft at the beginning of the game"
        "tmdisplay": "Draft",
        "nobeginner": true
      }
    },
    "default": 0
  }
  */

  "101": {
    "name": "Mode",
    "default": 0,
    "values": {
      "0": {
        "name": "Classic",
        "description": "Include player castle attacks",
        "tmdisplay": "Classic",
        "nobeginner": true,
      },
      "1": {
        "name": "Siege",
        "description": "No player castle attacks",
        "tmdisplay": "Siege",
      },
    },
  },

  "102": {
    "name": "Difficulty",
    "values": {
      "0": {
        "name": "Easy",
        "tmdisplay": "Easy",
        "nobeginner": true,
      },
      "1": {
        "name": "Medium",
        "tmdisplay": "Medium",
        "nobeginner": true,
      },
      "2": {
        "name": "Hard",
        "tmdisplay": "Hard",
        "nobeginner": true,
      },
    },
  },
}
