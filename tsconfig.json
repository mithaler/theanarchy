{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": false,
    "lib": ["dom", "esnext"],
    "sourceMap": false,
    "verbatimModuleSyntax": true,
    "rootDir": "."
  },
  "include": ["*.d.ts", "modules/**/*.d.ts", "modules/**/*.ts"]
}
